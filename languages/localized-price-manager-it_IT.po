#. translators: %d: number of migrations that failed.
#: src/Core/Lifecycle/SchemaUpgrader.php:127
#, php-format
msgid "Localized Price Manager could not apply %d pending database migration. The plugin is running against an older schema; run \"wp d6n-lpm migrate run\" or check the diagnostic log."
