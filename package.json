{
	"name": "localized-price-manager",
	"version": "1.0.0",
	"description": "Localized Price Manager for WooCommerce",
	"license": "GPL-2.0-or-later",
	"main": "index.js",
	"author": "Türker Yıldırım",
	"type": "module",
	"keywords": [
		"wordpress",
		"woocommerce",
		"price",
		"localized",
		"plugin"
	],
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "webpack --mode development --watch",
		"build": "webpack --mode production && sass assets/src/scss/rtl.scss assets/dist/css/rtl.css --style compressed --no-source-map",
		"scss:build": "sass assets/src/scss:assets/dist/css --style compressed",
		"production": "pnpm run build",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"test:matrix": "node tests/matrix/run-matrix.mjs --jobs 5",
		"test:matrix:full": "node tests/matrix/run-matrix.mjs --full --jobs 5",
		"test:e2e": "playwright test",
		"e2e:start": "node tests/e2e/start-site.mjs",
		"e2e:start:floor": "node tests/e2e/start-site.mjs --floor",
		"e2e:stop": "node tests/e2e/start-site.mjs --down",
		"check:js": "eslint \"assets/src/js/**/*.js\"",
		"check:css": "stylelint \"assets/src/scss/**/*.scss\"",
		"check": "pnpm run \"/^check:/\"",
		"version:set": "node tools/set-version.mjs",
		"version:check": "node tools/set-version.mjs --check",
		"lint:js": "eslint assets/src/js/**/*.js --fix",
		"lint:css": "stylelint assets/src/scss/**/*.scss --fix",
		"lint": "pnpm run \"/^lint:/\"",
		"format": "prettier --write \"assets/src/**/*.{js,scss,css}\"",
		"package": "pnpm run production && node tools/package.mjs"
	},
	"devDependencies": {
		"@babel/core": "^7.24.0",
		"@babel/preset-env": "^7.24.0",
		"@eslint/js": "^9.39.0",
		"@fullhuman/postcss-purgecss": "^8.0.0",
		"@playwright/test": "^1.62.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"autoprefixer": "^10.4.18",
		"babel-loader": "^9.1.3",
		"bestzip": "^2.2.1",
		"core-js": "^3.46.0",
		"css-loader": "^6.10.0",
		"css-minimizer-webpack-plugin": "^6.0.0",
		"eslint": "^8.57.1",
		"globals": "^16.5.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"mini-css-extract-plugin": "^2.8.1",
		"postcss": "^8.4.35",
		"postcss-loader": "^8.2.1",
		"prettier": "^3.2.5",
		"regenerator-runtime": "^0.14.1",
		"rimraf": "^6.1.3",
		"sass": "^1.99.0",
		"sass-loader": "^14.1.1",
		"style-loader": "^3.3.4",
		"stylelint": "^16.25.0",
		"stylelint-config-recess-order": "^7.4.0",
		"stylelint-config-standard-scss": "^13.1.0",
		"stylelint-scss": "^6.12.1",
		"terser-webpack-plugin": "^5.3.10",
		"webpack": "^5.90.3",
		"webpack-cli": "^5.1.4"
	},
	"browserslist": [
		"last 3 Chrome versions",
		"last 3 Safari versions",
		"last 3 Firefox versions",
		"last 3 Android versions",
		"ie 11",
		"Edge >= 79"
	],
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=10.33.0"
	}
}
